<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sql_lite_EF9_Maui_sample_2026.Pages.CategoryProductsPage"
             xmlns:data="clr-namespace:Sql_lite_EF9_Maui_sample_2026.ViewModels"
             Title="CategoryPage">
    <!--Data binding done code behind in constructor-->
    <VerticalStackLayout>
        <Label 
            Text="Categoy Products for"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label Text="{Binding CurrentCategory.Description}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" >
        </Label>
        <HorizontalStackLayout>
        <Label Text="Number of Products in thsi category "
            VerticalOptions="Center" 
            HorizontalOptions="Center" >
        </Label>
            <Label Text="{Binding CurrentCategory.Products.Count}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" >
        </Label>
        </HorizontalStackLayout>
       
    </VerticalStackLayout>
</ContentPage>